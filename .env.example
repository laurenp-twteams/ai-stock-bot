# Copy this file to .env for local testing and fill in your real webhook URL.
# Never commit the .env file itself - it's excluded via .gitignore.
# In GitHub Actions, set this as a repository secret instead (Settings ->
# Secrets and variables -> Actions) and reference it as ${{ secrets.DISCORD_WEBHOOK_URL }}.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
